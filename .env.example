POSTGRES_USER=stockmarket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockmarket
DATABASE_URL=postgresql://stockmarket:change-me@127.0.0.1:5432/stockmarket
SEC_USER_AGENT="Your Name your-email@example.com"

# Optional: which local chat model to use (default shown)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:latest
# Optional: where database backups go (default: the "backups" folder in the project). Use a drive that
# survives this disk failing, e.g. an external or synced folder.
# BACKUP_DIR=D:\stockmarket-backups
# Optional: API port and the web app addresses allowed to call it
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
