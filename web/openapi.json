  "info": {
    "description": "Read-only access to prices, news, sentiment, SEC filings, and the filing-grounded copilot. Summaries of public filings, not financial advice.",
    "title": "stockMarket API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/copilot": {
      "post": {
        "description": "Answer a question from the stored filings, with numbered citations. Can take several seconds.",
        "operationId": "copilot_api_copilot_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopilotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CopilotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Copilot",
        "tags": [
          "copilot"
        ]
      }
    },
    "/api/filings/search": {
      "get": {
        "description": "Semantic search over filing passages.",
        "operationId": "search_api_filings_search_get",
        "parameters": [
          {
            "description": "What to look for, in plain English",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "What to look for, in plain English",
              "maxLength": 300,
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "Repeat to search several tickers",
            "in": "query",
            "name": "symbol",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeat to search several tickers",
              "title": "Symbol"
            }
          },
          {
            "in": "query",
            "name": "form",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "enum": [
                      "10-K",
                      "10-Q",
                      "8-K"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Form"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
