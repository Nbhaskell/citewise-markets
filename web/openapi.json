          "companies": {
            "items": {
              "type": "string"
            },
            "title": "Companies",
            "type": "array"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "grounded": {
            "description": "True when the answer cites at least one real passage",
            "title": "Grounded",
            "type": "boolean"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "refused": {
            "description": "True when nothing relevant was found, so the model wasn't asked",
            "title": "Refused",
            "type": "boolean"
          },
          "searches": {
            "items": {
              "type": "string"
            },
            "title": "Searches",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "unverified_numbers": {
            "description": "Figures in the answer that are not in the cited passages. Show a warning if non-empty",
            "items": {
              "type": "string"
            },
            "title": "Unverified Numbers",
            "type": "array"
          }
        },
        "required": [
          "question",
          "answer",
          "refused",
          "grounded",
          "companies",
          "unverified_numbers",
          "sources",
          "searches",
          "disclaimer"
