      "CopilotRequest": {
        "properties": {
          "limit": {
            "default": 6,
            "description": "Passages to give the model",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "question": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          },
          "symbols": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 5,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tickers to restrict to. Default: detected from the question",
            "title": "Symbols"
          }
        },
        "required": [
          "question"
        ],
        "title": "CopilotRequest",
        "type": "object"
      },
      "CopilotResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
